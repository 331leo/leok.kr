      },
      {
        name: '넷마블 마블 퓨처 레볼류션 커뮤니티 관리 솔루션 개발',
        desc: '넷마블 자회사인 IGS의 의뢰로 수십만 명 규모의 마블 퓨처 레볼류션 디스코드 커뮤니티 관리 시스템, 미니게임 시스템, 모더레이션 어드민 페이지를 개발했습니다.',
      }
    ],
  },
];

// 역순 (최신→과거)
const timeline = [
  {
    date: '2023.05',
    kind: 'activity',
    title: '국제과학기술경진대회(ISEF) 2023 국가대표',
