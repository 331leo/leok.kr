// ── Component ───────────────────────────────────

const Portfolio = () => {
  const [scrolled, setScrolled] = useState(false);

  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    return () => window.removeEventListener('scroll', onScroll);
  }, []);

  return (
    <div className="pf">
      <div className={`pf-nav-bg${scrolled ? ' pf-nav-bg--scrolled' : ''}`} aria-hidden="true" />

      {/* ── NAV: 로고만 ── */}
      <header className="pf-nav">
        <a href="#top" className="pf-nav__logo">
          <img src="/assets/img/logo/light.png" alt="LeoK" className="pf-nav__logo-img" />
        </a>
      </header>

      <main className="pf-main" id="top">

        {/* ── HERO ── */}
        <section className="pf-hero">
          <div className="pf-hero__text">
            <span className="pf-hero__greeting">안녕하세요, 저는</span>
            <h1 className="pf-hero__name">
              김동현<span className="pf-hero__imnida">입니다.</span>
            </h1>
            <p className="pf-hero__name-en">Donghyun Kim <br/><p style={{ fontSize: '0.7em', fontWeight: 'normal' }}>(Aka. Leo Kim)</p></p>
            <p className="pf-hero__tagline" style={{ fontStyle: 'italic' }}>
              SW 기술로 세상에 작지만 의미 있는 변화를 만듭니다. 😄
            </p>
            <div className="pf-social">
              <a href="mailto:me@leok.kr" className="pf-social__item">
                <IconMail />
                <span>me@leok.kr</span>
              </a>
              <a href="https://github.com/331leo" target="_blank" rel="noreferrer" className="pf-social__item">
                <IconGithub />
                <span>github.com/331leo</span>
              </a>
              <a href="https://www.instagram.com/k.dh05" target="_blank" rel="noreferrer" className="pf-social__item">
                <IconInstagram />
                <span>@k.dh05</span>
              </a>
            </div>
          </div>
          <div className="pf-hero__img-wrap">
            <img src={PROFILE_IMAGE} alt="김동현 프로필" className="pf-hero__img" />
          </div>
        </section>

        {/* ── EXPERIENCE ── */}
        <section className="pf-section" id="experience">
          <span className="pf-label">경력</span>
          <h2 className="pf-section__title">Work Experience</h2>
          {experiences.map((exp) => (
            <div className="pf-exp" key={exp.company}>
              <div className="pf-exp__left">
                {exp.companyUrl
                  ? <a href={exp.companyUrl} target="_blank" rel="noreferrer" className="pf-exp__company">{exp.company}<IconExternal /></a>
                  : <span className="pf-exp__company">{exp.company}</span>
                }
                <span className="pf-exp__period">{exp.period}</span>
                <span className="pf-exp__role">{exp.role}</span>
                {exp.desc && <p className="pf-exp__desc">{exp.desc}</p>}
              </div>
              <div className="pf-exp__right">
                {exp.projects.map((proj) => (
                  <div className="pf-project" key={proj.name}>
                    {proj.url
                      ? <a href={proj.url} target="_blank" rel="noreferrer" className="pf-project__name pf-project__name--link">{proj.name} <IconExternal /></a>
                      : proj.name && <h3 className="pf-project__name">{proj.name}</h3>
                    }
                    {proj.desc && <p className="pf-project__desc">{proj.desc}</p>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </section>

        <div className="pf-divider" />

        {/* ── AWARDS ── */}
        <section className="pf-section" id="awards">
          <span className="pf-label">활동 &amp; 수상</span>
          <h2 className="pf-section__title">Awards &amp; Activities</h2>
          <div className="pf-awards">
            {timeline.map((item) => (
              <div className={`pf-award pf-award--${item.kind}`} key={item.title + item.date}>
                <div className="pf-award__meta">
                  <span className="pf-award__date">{item.date}</span>
                  {item.kind === 'award' && <span className="pf-award__badge">수상</span>}
                </div>
                {item.link
                  ? <a href={item.link} target="_blank" rel="noreferrer" className="pf-award__title pf-award__title--link">{item.title} <IconExternal /></a>
                  : <h3 className="pf-award__title">{item.title}</h3>
                }
                {item.org && (
                  <span className="pf-award__org">
                    {item.orgUrl
                      ? <a href={item.orgUrl} target="_blank" rel="noreferrer">{item.org}</a>
                      : item.org}
                  </span>
                )}
                <p className="pf-award__desc">{item.desc}</p>
              </div>
            ))}
          </div>
        </section>

        <div className="pf-divider" />

        {/* ── EDUCATION ── */}
        <section className="pf-section" id="education">
          <span className="pf-label">학력</span>
          <h2 className="pf-section__title">Education</h2>
          <div className="pf-edu-list">
            {education.map((e) => (
              <div className="pf-edu" key={e.school}>
                <span className="pf-edu__period">{e.period}</span>
                <div className="pf-edu__info">
                  {e.url
                    ? <a href={e.url} target="_blank" rel="noreferrer" className="pf-edu__school">{e.school}</a>
                    : <strong className="pf-edu__school">{e.school}</strong>}
                  <span className="pf-edu__major">{e.major}</span>
                </div>
              </div>
            ))}
          </div>
        </section>


      </main>

      {/* ── FOOTER ── */}
      <footer className="pf-footer">
        <p>
          © {new Date().getFullYear()} Donghyun Kim &nbsp;·&nbsp;{' '}
          <a href="mailto:me@leok.kr">me@leok.kr</a>
        </p>
      </footer>
    </div>
  );
};

export default Portfolio;
